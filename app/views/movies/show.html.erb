<% content_for :title, @movie.title %>

<section class="card">
  <%= render @movie %>

  <div class="actions">
    <%= link_to "Edit", edit_movie_path(@movie), class: "btn btn-primary" %>
    <%= link_to "Back to movies", movies_path, class: "btn" %>
    <%= button_to "Delete", @movie, method: :delete, class: "btn btn-danger",
          form: { onsubmit: "return confirm('Delete this movie?')" } %>
  </div>
</section>
  </div>
</section>
