<div id="<%= dom_id movie %>">
  <h1><%= movie.title %></h1>

  <dl class="details">
    <dt>Rating</dt>
    <dd><%= movie.rating %></dd>

    <dt>Release date</dt>
    <dd><%= release_date_for(movie) %></dd>

    <dt>Description</dt>
    <dd><%= movie.description.presence || "No description yet." %></dd>
  </dl>
</div>
